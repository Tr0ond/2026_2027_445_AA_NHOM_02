  <diagram id="70uBoIQATIalHBxs6F4V" name="Trang-2">
    <mxGraphModel dx="2112" dy="1231" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% TẦNG CLIENT\n    subgraph TIER_CLIENT [\&quot;Client Tier (Tầng người dùng)\&quot;]\n        Client[\&quot;💻 Client&lt;br/&gt;&lt;i&gt;(Admin/Master, Giảng viên, Sinh viên)&lt;/i&gt;\&quot;]\n    end\n\n    %% RANH GIỚI HỆ THỐNG\n    subgraph SYSTEM [\&quot;HỆ THỐNG EDUMANAGE (Application Boundary)\&quot;]\n        \n        Comm[\&quot;🔴 Communication / API Gateway&lt;br/&gt;&lt;i&gt;(Tiếp nhận HTTP / REST / WebSocket)&lt;/i&gt;\&quot;]\n        \n        EventBus{{\&quot;⚡ Application Event Bus (Kênh điều phối &amp; truyền thông sự kiện)\&quot;}}\n        \n        subgraph COMPONENTS [\&quot;Mô-đun chức năng (Components)\&quot;]\n            direction LR\n            C1[\&quot;📦 Quản lý Hệ thống&lt;br/&gt;&lt;b&gt;Tài khoản, Môn/Lớp, SV, Phân công&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(US19, US20, US21, US22, US23)&lt;/i&gt;\&quot;]\n            C2[\&quot;📦 Lớp học Trực tuyến&lt;br/&gt;&lt;b&gt;Phòng học ảo &amp; Tương tác&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(US06, US07, US12, US13)&lt;/i&gt;\&quot;]\n            C3[\&quot;📦 Điểm danh Thông minh&lt;br/&gt;&lt;b&gt;Mã QR động &amp; Điểm danh thủ công&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(US08, US09, US14, US15, US16)&lt;/i&gt;\&quot;]\n            C4[\&quot;📦 Quản lý Điểm số&lt;br/&gt;&lt;b&gt;Cơ cấu điểm &amp; Nhập/Xem điểm&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(US11, US18, US23)&lt;/i&gt;\&quot;]\n            C5[\&quot;📦 Thống kê, Báo cáo&lt;br/&gt;&lt;b&gt;Dashboard &amp; Xuất file Excel/PDF&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(US17, US24)&lt;/i&gt;\&quot;]\n        end\n\n        DataConnect[\&quot;═ Data Access Connector / Connection Pooling (Tầng truy xuất dữ liệu) ═\&quot;]\n    end\n\n    %% TẦNG CƠ SỞ DỮ LIỆU\n    subgraph TIER_DB [\&quot;Database Tier (Tầng dữ liệu)\&quot;]\n        DB[(\&quot;🗄️ Database Server&lt;br/&gt;&lt;i&gt;(MySQL DBMS - Port 3306)&lt;/i&gt;\&quot;)]\n    end\n\n    %% KẾT NỐI (CONNECTORS)\n    Client &lt;==&gt;|\&quot;Interact (Giao thức HTTP / WSS)\&quot;| Comm\n    Comm ==&gt;|\&quot;Điều phối luồng\&quot;| EventBus\n    \n    EventBus &lt;--&gt; C1\n    EventBus &lt;--&gt; C2\n    EventBus &lt;--&gt; C3\n    EventBus &lt;--&gt; C4\n    EventBus &lt;--&gt; C5\n\n    C1 --&gt; DataConnect\n    C2 --&gt; DataConnect\n    C3 --&gt; DataConnect\n    C4 --&gt; DataConnect\n    C5 --&gt; DataConnect\n\n    DataConnect &lt;==&gt;|\&quot;Truy vấn SQL / TCP:3306\&quot;| DB\n\n    %% STYLING\n    style Client fill:#EAECEE,stroke:#2C3E50,stroke-width:2px,color:#1C2833\n    style Comm fill:#FADBD8,stroke:#C0392B,stroke-width:2px,color:#922B21\n    style EventBus fill:#FCF3CF,stroke:#B7950B,stroke-width:2px,color:#7D6608\n    style DataConnect fill:#D4EFDF,stroke:#27AE60,stroke-width:1.5px,color:#145A32\n    style DB fill:#D6EAF8,stroke:#2980B9,stroke-width:2px,color:#1B4F72\n    \n    style C1 fill:#FDEDEC,stroke:#E74C3C,stroke-width:1.5px,color:#78281F\n    style C2 fill:#FDEDEC,stroke:#E74C3C,stroke-width:1.5px,color:#78281F\n    style C3 fill:#FDEDEC,stroke:#E74C3C,stroke-width:1.5px,color:#78281F\n    style C4 fill:#FDEDEC,stroke:#E74C3C,stroke-width:1.5px,color:#78281F\n    style C5 fill:#FDEDEC,stroke:#E74C3C,stroke-width:1.5px,color:#78281F\n    \n    style SYSTEM fill:#F8F9F9,stroke:#566573,stroke-width:2px,stroke-dasharray: 5 5&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1pkqBktTImIByn9X-BJl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=17;" vertex="1">
            <mxGeometry as="geometry" />

    <mxGraphModel dx="3051" dy="1778" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% GÓI CONTROLLER\n    subgraph PKG_CTRL [\&quot;Gói Controller (Tầng điều khiển)\&quot;]\n        CtrlRoot[\&quot;Controller\&quot;]\n        \n        C_Home[\&quot;HomeController\&quot;]\n        C_Auth[\&quot;AuthController (Login/Profile)\&quot;]\n        C_Account[\&quot;AccountController (QL Tài khoản, SV)\&quot;]\n        C_Class[\&quot;ClassroomController (Lớp học, Môn học)\&quot;]\n        C_Attend[\&quot;AttendanceController (Điểm danh QR, Thủ công)\&quot;]\n        C_Grade[\&quot;GradeController (QL Điểm số)\&quot;]\n        C_Report[\&quot;ReportController (Thống kê, Báo cáo)\&quot;]\n        \n        CtrlRoot --&gt; C_Home\n        CtrlRoot --&gt; C_Auth\n        CtrlRoot --&gt; C_Account\n        CtrlRoot --&gt; C_Class\n        CtrlRoot --&gt; C_Attend\n        CtrlRoot --&gt; C_Grade\n        CtrlRoot --&gt; C_Report\n    end\n\n    %% GÓI VIEWS\n    subgraph PKG_VIEW [\&quot;Gói Views (Tầng giao diện)\&quot;]\n        subgraph SubViews_Public [\&quot;Giao diện chung / Người dùng\&quot;]\n            V_Home[\&quot;Home View\&quot;]\n            V_Login[\&quot;Login / Profile View\&quot;]\n            V_Classroom[\&quot;Virtual Classroom UI\&quot;]\n            V_QRScanner[\&quot;QR Attendance UI\&quot;]\n        end\n        \n        subgraph SubViews_Admin [\&quot;Giao diện Quản trị &amp; Giảng dạy\&quot;]\n            V_Account[\&quot;QL Tài khoản &amp; SV UI\&quot;]\n            V_Course[\&quot;QL Môn học &amp; Lớp học UI\&quot;]\n            V_Grade[\&quot;QL Điểm số &amp; Bảng điểm UI\&quot;]\n            V_Report[\&quot;Thống kê &amp; Báo cáo UI\&quot;]\n        end\n    end\n\n    %% GÓI MODELS\n    subgraph PKG_MODEL [\&quot;Gói Models (Tầng dữ liệu &amp; Thực thể)\&quot;]\n        ModelRoot[\&quot;Models\&quot;]\n        \n        M_User[\&quot;UserModel (User, Student, Lecturer)\&quot;]\n        M_Class[\&quot;ClassroomModel (Subject, CourseClass)\&quot;]\n        M_Attend[\&quot;AttendanceModel (QRSession, AttendanceRecord)\&quot;]\n        M_Grade[\&quot;GradeModel (GradeItem, Score)\&quot;]\n        M_Report[\&quot;ReportModel (StatisticSummary, Log)\&quot;]\n        \n        ModelRoot --&gt; M_User\n        ModelRoot --&gt; M_Class\n        ModelRoot --&gt; M_Attend\n        ModelRoot --&gt; M_Grade\n        ModelRoot --&gt; M_Report\n    end\n\n    %% MỐI QUAN HỆ GIỮA CÁC GÓI\n    PKG_CTRL -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| PKG_VIEW\n    PKG_CTRL -.-&gt;|\&quot;&lt;&lt;include&gt;&gt;\&quot;| PKG_MODEL\n\n    %% STYLING\n    classDef pkgTitle fill:#FFFFFF,stroke:#333333,stroke-width:1.5px,color:#111111;\n    classDef rootNode fill:#2980B9,stroke:#1B4F72,stroke-width:1.5px,color:#FFFFFF,font-weight:bold;\n    classDef ctrlNode fill:#D4E6F1,stroke:#2980B9,stroke-width:1px,color:#1B4F72;\n    classDef viewNode fill:#E8DAEF,stroke:#8E44AD,stroke-width:1px,color:#512E5F;\n    classDef modelNode fill:#D5F5E3,stroke:#27AE60,stroke-width:1px,color:#145A32;\n\n    class CtrlRoot,ModelRoot rootNode;\n    class C_Home,C_Auth,C_Account,C_Class,C_Attend,C_Grade,C_Report ctrlNode;\n    class V_Home,V_Login,V_Classroom,V_QRScanner,V_Account,V_Course,V_Grade,V_Report viewNode;\n    class M_User,M_Class,M_Attend,M_Grade,M_Report modelNode;\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="EYhyYy3u0fYJINkMHyxN-1">

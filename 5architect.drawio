  <diagram id="AWhvn8TwbFTOOFP7n_1L" name="Trang-6">
    <mxGraphModel dx="2346" dy="2000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    %% NÚT THIẾT BỊ NGƯỜI DÙNG\n    subgraph NODE_MEMBER [\&quot;Node: Member Client (Sinh viên / Giảng viên)\&quot;]\n        MBrowser[\&quot;&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;Browser / Mobile UI&lt;/b&gt;&lt;br/&gt;(Giao diện học tập, quét QR)\&quot;]\n    end\n\n    subgraph NODE_ADMIN [\&quot;Node: Admin Client (Quản trị viên)\&quot;]\n        ABrowser[\&quot;&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;Browser&lt;/b&gt;&lt;br/&gt;(Giao diện quản trị hệ thống)\&quot;]\n    end\n\n    %% NÚT MÁY CHỦ ỨNG DỤNG\n    subgraph NODE_APP [\&quot;Node: Application Server (Web Server)\&quot;]\n        direction TB\n        UI[\&quot;&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;User Interface&lt;/b&gt;&lt;br/&gt;(Web Controller &amp; Routing)\&quot;]\n        RES[\&quot;&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;Resource Management &amp; Exploitation&lt;/b&gt;&lt;br/&gt;(Xử lý nghiệp vụ Lớp học, Điểm danh QR, Điểm số)\&quot;]\n        DA[\&quot;&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;Data Access&lt;/b&gt;&lt;br/&gt;(Tầng truy xuất dữ liệu &amp; ORM)\&quot;]\n\n        UI --&gt;|Internal Call| RES\n        RES --&gt;|CRUD Operations| DA\n    end\n\n    %% NÚT MÁY CHỦ CƠ SỞ DỮ LIỆU\n    subgraph NODE_DB [\&quot;Node: Database Server\&quot;]\n        MySQL[\&quot;&lt;&lt;component&gt;&gt;&lt;br/&gt;&lt;b&gt;MySQL DBMS&lt;/b&gt;&lt;br/&gt;(EduManage Database - Port 3306)\&quot;]\n    end\n\n    %% LIÊN KẾT GIỮA CÁC NÚT\n    MBrowser --&gt;|HTTPS / WSS| UI\n    ABrowser --&gt;|HTTPS| UI\n    DA --&gt;|JDBC / SQL (TCP:3306)| MySQL\n\n    %% ĐỊNH DẠNG MÀU SẮC\n    classDef clientNode fill:#EAEDED,stroke:#2C3E50,stroke-width:1.5px,color:#1C2833;\n    classDef appComp fill:#D4E6F1,stroke:#2980B9,stroke-width:1.5px,color:#1B4F72;\n    classDef dbComp fill:#FCF3CF,stroke:#D35400,stroke-width:1.5px,color:#78281F;\n\n    class MBrowser,ABrowser clientNode;\n    class UI,RES,DA appComp;\n    class MySQL dbComp;\n\n    style NODE_MEMBER fill:#F8F9F9,stroke:#566573,stroke-width:1.5px,stroke-dasharray: 4 4\n    style NODE_ADMIN fill:#F8F9F9,stroke:#566573,stroke-width:1.5px,stroke-dasharray: 4 4\n    style NODE_APP fill:#EBF5FB,stroke:#1B4F72,stroke-width:2px\n    style NODE_DB fill:#FDEDEC,stroke:#78281F,stroke-width:2px\n```[cite: 1, 8]&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="VGAmR9QLQMt2dI4gmWLk-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontSize=20;" vertex="1">
            <mxGeometry height="544" width="1446" as="geometry" />
          </mxCell>
